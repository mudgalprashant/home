# Copy to .env.local and fill in real values. .env.local is git-ignored — never commit it.
# See KB/security.md §4.2 rule 7 and §4.3 rules 10-11.

# Public site URL. Used for canonical URLs, OG image absolute paths, and sitemap.
# Local: http://localhost:3000 — Production: your Vercel or custom domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase. Get both from Project Settings → API. See supabase/README.md.
#
# Both are intentionally NEXT_PUBLIC_ and ship inside the browser bundle. That is
# by design, not a leak: the anon key is meant to be public, and Postgres Row
# Level Security — not key secrecy — is what prevents unauthorized writes.
# See KB/security.md §1.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# DO NOT ADD A SUPABASE SERVICE ROLE KEY.
# It bypasses RLS entirely. This architecture has no need for one, and its absence
# is itself a security control (KB/system-design.md §7.6, KB/security.md §4.1 rule 4).
